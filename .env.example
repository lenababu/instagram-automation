# ---- Google (OAuth "Desktop app" client; refresh token from scripts/get_google_refresh_token.py) ----
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx
GOOGLE_REFRESH_TOKEN=1//0xxxxxxxxxxxxxxxxxxxx
GOOGLE_DRIVE_VIDEO_FOLDER_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz
GOOGLE_DRIVE_THUMBNAIL_FOLDER_ID=1ZyXwVuTsRqPoNmLkJiHgFeDcBa
GOOGLE_SHEETS_ID=1SpreadsheetIdxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Groq (speech, vision and caption generation; one free key) ----
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
# Optional overrides
GROQ_WHISPER_MODEL=whisper-large-v3
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_TEXT_MODEL=openai/gpt-oss-120b
# Optional: separate key for the vision model (defaults to GROQ_API_KEY)
VISION_API_KEY=

# ---- Cloudinary (free plan) ----
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ---- Meta / Instagram Graph API ----
META_ACCESS_TOKEN=EAAGxxxxxxxxxxxxxxxxxxxxxxxx
INSTAGRAM_USER_ID=17841400000000000
META_API_VERSION=v24.0

# ---- Telegram (optional) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Behaviour ----
# Optional brand context injected into the caption prompt
BRAND_CONTEXT=
# true = run everything except creating/publishing the Instagram container and writing Published to the sheet
DRY_RUN=true
# Max video size (MB) accepted by Cloudinary free plan; larger files are re-encoded
MAX_UPLOAD_MB=95
LOG_LEVEL=INFO
